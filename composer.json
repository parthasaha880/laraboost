{
    "name": "parthasaha880/laraboost",
    "description": "Laravel Artisan command that clears and rebuilds caches, then lists routes.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "artisan",
        "laraboost",
        "optimize",
        "cache"
    ],
    "authors": [
        {
            "name": "Partha Saha",
            "homepage": "https://github.com/parthasaha880"
        }
    ],
    "homepage": "https://github.com/parthasaha880/laraboost",
    "support": {
        "issues": "https://github.com/parthasaha880/laraboost/issues",
        "source": "https://github.com/parthasaha880/laraboost"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "ParthaSaha\\LaraBoost\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ParthaSaha\\LaraBoost\\LaraBoostServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
